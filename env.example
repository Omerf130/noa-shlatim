# Copy to .env.local and fill in values. Never commit .env.local.

# MongoDB Atlas (server-only — do not use NEXT_PUBLIC_*)
MONGODB_URI=

# Local one-time admin bootstrap (npm run seed:admin) — do NOT set on Vercel
# ADMIN_SEED_EMAIL=
# ADMIN_SEED_PASSWORD=

# Optional admin session TTL in seconds (default 604800 = 7 days)
# ADMIN_SESSION_MAX_AGE_SECONDS=

# Vercel Blob — private store (server-only; do not use NEXT_PUBLIC_*)
# Local dev / npm run verify:blob:
# BLOB_READ_WRITE_TOKEN=
# On Vercel: linked store provides OIDC + BLOB_STORE_ID (no webhooks required)

# OpenAI illustration generation (existing)
OPENAI_API_KEY=
AI_ILLUSTRATION_ENABLED=true
# OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
# OPENAI_IMAGE_SIZE=1024x1024
# OPENAI_IMAGE_QUALITY=high
# OPENAI_IMAGE_TIMEOUT_MS=120000
# AI_MAX_UPLOAD_BYTES=10485760
# ALLOW_MOCK_ILLUSTRATION=false

# Public site origin (server-side PayPlus refURL_* in Batch B+)
# Production: https://www.noa-sign.co.il
# SITE_URL=

# PayPlus — server-only; never use NEXT_PUBLIC_* (used from Batch B onward)
# PAYPLUS_API_KEY=
# PAYPLUS_SECRET_KEY=
# PAYPLUS_PAYMENT_PAGE_UID=
# PAYPLUS_API_URL=

# Finbot — server-only income documents (חשבונית מס קבלה); never use NEXT_PUBLIC_*
# FINBOT_API_SECRET=
# FINBOT_API_BASE_URL=https://api.finbotai.co.il
